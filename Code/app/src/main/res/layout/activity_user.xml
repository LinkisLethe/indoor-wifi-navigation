<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UserActivity">

    <!-- 顶部选项卡(未来导航用) -->
    <LinearLayout
        android:id="@+id/tabLayout"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/design_default_color_primary"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnTabLocate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Relocate"
            android:textColor="@android:color/white"
            android:background="@android:color/holo_blue_dark"/>

        <Button
            android:id="@+id/btnTabNavigate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Navigation"
            android:textColor="@android:color/white"
            android:background="@android:color/transparent"/>
    </LinearLayout>

    <!-- 室内地图 + 当前定位显示区域 -->
    <ScrollView
        android:id="@+id/scrollLocate"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toTopOf="@id/layoutNews"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:padding="12dp">

        <!-- ScrollView 必须只有一个直接子 View，这里用垂直 LinearLayout 包一层 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 上半部分：左边楼层按钮 + 右边平面图 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 左侧楼层选择栏 -->
                <LinearLayout
                    android:id="@+id/floor_selector"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="#EEEEEE"
                    android:padding="4dp">

                    <Button
                        android:id="@+id/btn_floor3"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="3F" />

                    <Button
                        android:id="@+id/btn_floor4"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="4F" />

                    <Button
                        android:id="@+id/btn_floor5"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="5F" />
                </LinearLayout>

                <!-- 右侧显示楼层平面图 -->
                <ImageView
                    android:id="@+id/img_floor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/floor3" />
            </LinearLayout>

            <!-- 下方定位信息 -->
            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Locating..."
                android:textSize="15sp"
                android:textColor="@android:color/black" />
        </LinearLayout>
    </ScrollView>


    <!-- 校内新闻栏 -->
    <LinearLayout
        android:id="@+id/layoutNews"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="#EEEEEE"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <Button
            android:id="@+id/btnRefreshNews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Refresh News"
            android:layout_gravity="right"/>

        <ScrollView
            android:id="@+id/scrollNews"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/newsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
